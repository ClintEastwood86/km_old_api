{
	"name": "kingmovies-backend",
	"version": "1.0.0",
	"description": "",
	"main": "./dist/main.js",
	"prisma": {
		"seed": "node ./dist/database/seed.js"
	},
	"scripts": {
		"start": "node ./dist/main.js",
		"start:production": "npm run dbpush:common && npm run dbpush:movies && prisma db seed && node ./dist/main.js",
		"dev": "nodemon",
		"lint": "eslint ./src",
		"lint:fix": "eslint ./src --fix",
		"build": "tsc",
		"test": "jest",
		"test:e2e": "jest --config jest.e2e.config.ts",
		"dbpush:common": "prisma db push",
		"dbpush:movies": "prisma db push --schema=prisma/movies.schema.prisma",
		"migrate:common": "prisma migrate dev",
		"migrate:movies": "prisma migrate dev --schema=prisma/movies.schema.prisma",
		"generate:common": "prisma generate",
		"generate:movies": "prisma generate --schema=prisma/movies.schema.prisma"
	},
	"license": "ISC",
